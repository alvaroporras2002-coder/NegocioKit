      </div>

    </div>

  </footer>


  <!-- =====================================================
       CALCULATOR LOGIC
       ===================================================== -->

  <script>

    (function () {

      "use strict";


      const form =
        document.getElementById(
          "breakEvenCalculator"
        );


      const fixedCostsInput =
        document.getElementById(
          "fixedCosts"
        );


      const averageSaleInput =
        document.getElementById(
          "averageSale"
        );


      const variableCostInput =
        document.getElementById(
          "variableCost"
        );


      const targetUnitsInput =
        document.getElementById(
          "targetUnits"
        );


      const errorBox =
        document.getElementById(
          "calculatorError"
        );


      const breakEvenUnitsOutput =
        document.getElementById(
          "breakEvenUnits"
        );


      const breakEvenRevenueOutput =
        document.getElementById(
          "breakEvenRevenue"
        );


      const contributionMarginOutput =
        document.getElementById(
          "contributionMargin"
        );


      const targetProfitOutput =
        document.getElementById(
          "targetProfit"
        );


      const projectedProfitOutput =
        document.getElementById(
          "projectedProfit"
        );


      function money(value) {

        return new Intl.NumberFormat(
          "en-US",
          {
            style: "currency",
            currency: "USD",
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }
        ).format(value);

      }


      function number(value) {

        return new Intl.NumberFormat(
          "en-US",
          {
            maximumFractionDigits: 0
          }
        ).format(value);

      }


      function showError(message) {

        errorBox.textContent =
          message;

        errorBox.style.display =
          "block";

      }


      function clearError() {

        errorBox.textContent =
          "";

        errorBox.style.display =
          "none";

      }


      form.addEventListener(
        "submit",
        function (event) {

          event.preventDefault();

          clearError();


          const fixedCosts =
            Number.parseFloat(
              fixedCostsInput.value
            );


          const averageSale =
            Number.parseFloat(
              averageSaleInput.value
            );


          const variableCost =
            Number.parseFloat(
              variableCostInput.value
            );


          const targetUnitsValue =
            Number.parseFloat(
              targetUnitsInput.value
            );


          if (
            !Number.isFinite(fixedCosts) ||
            fixedCosts < 0
          ) {

            showError(
              "Ingresa costos fijos válidos."
            );

            fixedCostsInput.focus();

            return;

          }


          if (
            !Number.isFinite(averageSale) ||
            averageSale <= 0
          ) {

            showError(
              "La venta promedio debe ser mayor que 0."
            );

            averageSaleInput.focus();

            return;

          }


          if (
            !Number.isFinite(variableCost) ||
            variableCost < 0
          ) {

            showError(
              "Ingresa un costo variable válido."
            );

            variableCostInput.focus();

            return;

          }


          if (variableCost >= averageSale) {

            showError(
              "El costo variable debe ser menor que la venta promedio."
            );

            variableCostInput.focus();

            return;

          }


          /*
           * Contribution margin per order
           */

          const contributionPerOrder =
            averageSale - variableCost;


          /*
           * Contribution margin percentage
           */

          const contributionMargin =
            (
              contributionPerOrder /
              averageSale
            ) * 100;


          /*
           * Break-even units
           */

          const breakEvenUnits =
            Math.ceil(
              fixedCosts /
              contributionPerOrder
            );


          /*
           * Break-even revenue
           */

          const breakEvenRevenue =
            breakEvenUnits *
            averageSale;


          /*
           * Optional projected result
           */

          let projectedProfit = 0;

          let targetProfit = 0;


          if (
            Number.isFinite(targetUnitsValue) &&
            targetUnitsValue > 0
          ) {

            projectedProfit =
              (
                targetUnitsValue *
                contributionPerOrder
              ) -
              fixedCosts;


            targetProfit =
              projectedProfit;

          }


          /*
           * Render results
           *
           * textContent is intentionally used instead
           * of innerHTML for user-controlled values.
           */

          breakEvenUnitsOutput.textContent =
            number(
              breakEvenUnits
            );


          breakEvenRevenueOutput.textContent =
            money(
              breakEvenRevenue
            );


          contributionMarginOutput.textContent =
            contributionMargin.toFixed(1) +
            "%";


          targetProfitOutput.textContent =
            money(
              targetProfit
            );


          projectedProfitOutput.textContent =
            money(
              projectedProfit
            );

        }
      );

    })();

  </script>

</body>

</html>
