  >

  <meta
    name="description"
    content="Calculadora de punto de equilibrio para restaurantes y pequeños negocios."
  >

  <meta
    name="theme-color"
    content="#f47721"
  >

  <title>
    Punto de Equilibrio | NegocioKit
  </title>

  <link
    rel="stylesheet"
    href="assets/css/styles.css"
  >
</head>

<body>

  <!-- =====================================================
       HEADER
       ===================================================== -->

  <header class="nk-header">

    <div class="nk-container nk-header-inner">

      <a
        href="index.html"
        class="nk-brand"
        aria-label="NegocioKit - Inicio"
      >

        <img
          src="assets/images/logo.png"
          alt="Logo de NegocioKit"
          width="42"
          height="42"
        >

        <div class="nk-brand-name">
          Negocio<span>Kit</span>
        </div>

      </a>


      <nav
        class="nk-nav"
        aria-label="Navegación principal"
      >

        <a
          href="index.html"
          class="nk-nav-link"
        >
          Inicio
        </a>

        <a
          href="tools.html"
          class="nk-nav-link"
          aria-current="page"
        >
